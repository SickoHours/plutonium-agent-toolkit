{
  "schema": 1,
  "note": "Repeatable offline modding tasks scored only from receipts and the files they inventory. The prompt is handed to the agent under test verbatim after substituting <REPO>, <RUN>, <FIXTURE> and <MOD_FF>. See docs/BENCHMARK.md. inputs_contain lists path suffixes the scored receipt's declared inputs must include; input_hash_from requires an input's recorded hash to equal another task's output hash. artifact_contains and artifact_excludes name byte strings the scored job's compiled scripts or readback must carry or must not carry.",
  "tasks": [
    {
      "id": "bench-01-compile-error",
      "prompt": "prompts/bench-01.md",
      "inputs": [
        "fixtures/bench-01/broken.gsc"
      ],
      "expect": {
        "routes": [
          "gsc compile"
        ],
        "final_status": "failed",
        "final_error_code": "backend_failed",
        "max_invocations": 3,
        "inputs_contain": [
          "tools/benchmark/fixtures/bench-01/broken.gsc"
        ]
      }
    },
    {
      "id": "bench-02-build-hello",
      "prompt": "prompts/bench-02.md",
      "inputs": [
        "examples/hello-zm"
      ],
      "expect": {
        "routes": [
          "project plan",
          "project build",
          "project verify"
        ],
        "final_status": "succeeded",
        "outputs_contain": [
          "packages/mod.ff"
        ],
        "max_invocations": 6,
        "inputs_contain": [
          "examples/hello-zm/project.json",
          "examples/hello-zm/scripts/hello.gsc"
        ]
      }
    },
    {
      "id": "bench-03-extract-rawfile",
      "prompt": "prompts/bench-03.md",
      "inputs": [
        "<MOD_FF>"
      ],
      "expect": {
        "routes": [
          "ff extract"
        ],
        "final_status": "succeeded",
        "outputs_match": [
          "assets/**/*.gsc"
        ],
        "max_invocations": 4,
        "input_hash_from": {
          "suffix": "packages/mod.ff",
          "task": "bench-02-build-hello",
          "output": "packages/mod.ff"
        }
      }
    },
    {
      "id": "bench-04-port-feature",
      "prompt": "prompts/bench-04.md",
      "inputs": [
        "examples/hello-zm",
        "examples/hello-zm-two"
      ],
      "expect": {
        "routes": [
          "project build",
          "project verify"
        ],
        "final_status": "succeeded",
        "outputs_contain": [
          "packages/mod.ff"
        ],
        "readback_contains": [
          "announce_round",
          "on_player_spawned"
        ],
        "max_invocations": 10,
        "inputs_contain": [
          "project.json",
          "scripts/hello.gsc"
        ]
      }
    },
    {
      "id": "bench-05-builtin-wrong-vm",
      "prompt": "prompts/bench-05.md",
      "inputs": [
        "fixtures/bench-05/face_glow.gsc"
      ],
      "expect": {
        "routes": [
          "knowledge builtin",
          "gsc compile"
        ],
        "final_status": "succeeded",
        "artifact_excludes": [
          "setanimknob"
        ],
        "artifact_contains": [
          "face_glow_think",
          "^3face glow armed"
        ],
        "max_invocations": 4,
        "inputs_contain": [
          "face_glow.gsc"
        ],
        "lookup": {
          "command": "knowledge builtin",
          "contains": [
            "setanimknob"
          ]
        }
      }
    },
    {
      "id": "bench-06-classify-then-fix",
      "prompt": "prompts/bench-06.md",
      "inputs": [
        "fixtures/bench-06/console_slice.log",
        "fixtures/bench-06/riser_glow.gsc"
      ],
      "expect": {
        "routes": [
          "knowledge signature",
          "gsc compile"
        ],
        "final_status": "succeeded",
        "artifact_excludes": [
          "bench_riser_glow"
        ],
        "artifact_contains": [
          "riser_glow_think",
          "^5riser glow armed"
        ],
        "max_invocations": 4,
        "inputs_contain": [
          "riser_glow.gsc",
          "console_slice.log"
        ],
        "lookup": {
          "command": "knowledge signature",
          "contains": [
            "clientfield"
          ]
        }
      }
    }
  ]
}
