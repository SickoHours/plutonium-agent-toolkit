{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pat.module-inspect/1 invocation envelope",
  "description": "Declaration-only producer protocol. Metadata validity does not establish payload availability, buildability, compatibility or gameplay evidence. file is a local producer path. Exit-2 argument/usage failures are ordinary invocation envelopes outside this inspection protocol and have no details.inspection. Inspection diagnostic field/message and envelope message/hint are bounded to 2048 UTF-16 code units; error_code to 200 UTF-16 code units. Supplementary characters count as two units and lone surrogates as one. JSON Schema maxLength is only a code-point upper bound; the transport enforces the stricter UTF-16 bound for JavaScript consumers. Lone surrogates are JSON-escaped on stdout without changing decoded values. Overlong pointers become / with an explicit offending-key limit message; excessive prose is replaced explicitly, never silently truncated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "toolkit_version",
    "command",
    "request_id",
    "at",
    "ok"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "toolkit_version": {
      "type": "string"
    },
    "command": {
      "const": "module inspect"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "$ref": "#/$defs/inspection"
    },
    "error_code": {
      "type": "string",
      "maxLength": 200
    },
    "message": {
      "type": "string",
      "maxLength": 2048
    },
    "hint": {
      "type": "string",
      "maxLength": 2048
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspection"
      ],
      "properties": {
        "inspection": {
          "$ref": "#/$defs/inspection"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "result"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "result": {
          "properties": {
            "validation": {
              "const": "metadata-valid"
            }
          }
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "error_code"
            ]
          },
          {
            "required": [
              "message"
            ]
          },
          {
            "required": [
              "hint"
            ]
          },
          {
            "required": [
              "details"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "error_code",
        "message",
        "details"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "details": {
          "properties": {
            "inspection": {
              "properties": {
                "validation": {
                  "const": "invalid"
                }
              }
            }
          }
        }
      },
      "not": {
        "required": [
          "result"
        ]
      }
    }
  ],
  "$defs": {
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "file",
        "sha256",
        "kind",
        "validation",
        "validation_scope",
        "metadata",
        "diagnostics"
      ],
      "properties": {
        "protocol": {
          "const": "pat.module-inspect/1"
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "module",
            "composition",
            "unknown"
          ]
        },
        "validation": {
          "enum": [
            "metadata-valid",
            "invalid"
          ]
        },
        "validation_scope": {
          "const": "declaration-only"
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/moduleMetadata"
            },
            {
              "$ref": "#/$defs/compositionMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "error_code",
              "message"
            ],
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^/",
                "maxLength": 2048
              },
              "error_code": {
                "type": "string",
                "maxLength": 200
              },
              "message": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        },
        "ledger": {
          "description": "Present only for a module declaration with an evidence.json beside it. The ledger's own validity; its defects never change the declaration's validation or the exit status. Format: docs/evidence-ledger.md.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "sha256",
            "validation",
            "rows",
            "types",
            "diagnostics"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "validation": {
              "enum": [
                "valid",
                "invalid"
              ]
            },
            "rows": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "types": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "enum": [
                      "lineage",
                      "authored",
                      "accepted-in-pack",
                      "extracted-from-release",
                      "built-alone",
                      "agent-reviewed",
                      "game-tested",
                      "player-accepted"
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "error_code",
                  "message"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "maxLength": 2048
                  },
                  "error_code": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "validation": {
              "const": "invalid"
            },
            "metadata": {
              "type": "null"
            },
            "diagnostics": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "validation": {
              "const": "metadata-valid"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "const": "module"
            },
            "metadata": {
              "$ref": "#/$defs/moduleMetadata"
            },
            "diagnostics": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "validation": {
              "const": "metadata-valid"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "const": "composition"
            },
            "metadata": {
              "$ref": "#/$defs/compositionMetadata"
            },
            "diagnostics": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    "moduleMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "game",
        "title",
        "category",
        "kind",
        "tags",
        "bases",
        "maps",
        "dependencies",
        "conflicts",
        "origin",
        "donor",
        "distribution",
        "menu_route",
        "payload",
        "lineage"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "game": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "donor": {
          "type": [
            "string",
            "null"
          ]
        },
        "distribution": {
          "enum": [
            "source",
            "seed",
            "private"
          ]
        },
        "menu_route": {
          "type": "string"
        },
        "payload": {
          "enum": [
            "recipe",
            "seed"
          ]
        },
        "recipes": {
          "description": "Present only when the declaration names per-target adapter recipes: the '<foundation>/<map>' targets it carries a cut for, sorted. The recipe paths themselves are not reported; inspection resolves no payload.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,32}/zm_[a-z0-9_]{1,32}$"
          }
        },
        "lineage": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 18,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "game",
                  "map",
                  "source",
                  "note"
                ],
                "properties": {
                  "game": {
                    "enum": [
                      "t4",
                      "t5"
                    ]
                  },
                  "map": {
                    "type": "string",
                    "pattern": "^zm_[a-z0-9_]{1,60}$"
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 400
                  }
                }
              }
            }
          ]
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "steps",
            "human_steps",
            "maps",
            "requires_probe"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "requires_probe": {
              "type": "boolean"
            },
            "steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "human_steps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "maps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "replaces": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "functions",
            "files"
          ],
          "properties": {
            "functions": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_/]+::[a-z0-9_]+$"
              }
            },
            "files": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "entry": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "replace",
            "register"
          ],
          "properties": {
            "replace": {
              "type": "string",
              "pattern": "^[a-z0-9_/]+::[a-z0-9_]+$"
            },
            "register": {
              "type": "string",
              "pattern": "^[a-z0-9_/]+::[a-z0-9_]+$"
            }
          }
        },
        "placements": {
          "description": "Present only when the declaration names placements: what the module needs placed on each target, never where. Format: docs/target-sets.md.",
          "type": [
            "array",
            "null"
          ],
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "needs",
              "occupant",
              "count",
              "fallback"
            ],
            "properties": {
              "needs": {
                "enum": [
                  "perk-machine",
                  "pack-a-punch",
                  "wall-buy",
                  "gobblegum",
                  "wunderfizz",
                  "mystery-box",
                  "rotation-slot",
                  "player-spawn",
                  "zone-fence",
                  "buildable-table",
                  "power-switch"
                ]
              },
              "occupant": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 120
              },
              "count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 256
                  },
                  {
                    "const": "any"
                  }
                ]
              },
              "fallback": {
                "enum": [
                  "refuse",
                  "rotation-slot",
                  "wunderfizz",
                  "spawn-room-default",
                  "omit"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 400
              }
            }
          }
        },
        "exclusive": {
          "description": "Present only when the declaration names exclusive: the roles this module owns outright. A pack has one owner per role. Format: docs/MODULES.md.",
          "type": "array",
          "maxItems": 6,
          "items": {
            "enum": [
              "hud",
              "box",
              "loadscreen",
              "boss",
              "perk-machines",
              "perk-art"
            ]
          }
        },
        "service": {
          "description": "Present only when the declaration names service: true when the module exists to own shared things, so others depend on it and ship no copy. Format: docs/MODULES.md.",
          "type": "boolean"
        },
        "dependency_kinds": {
          "description": "Present only when at least one dependencies entry was an object: what each dependency is for, by id. A kind of null is an entry that did not say. Format: docs/MODULES.md.",
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "why"
            ],
            "properties": {
              "kind": {
                "anyOf": [
                  {
                    "enum": [
                      "call",
                      "name",
                      "service",
                      "runtime"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "why": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 400
              }
            }
          }
        },
        "parameters": {
          "description": "Present only when the declaration names parameters: what a composition may set on this module, with each parameter's type, constraint, default and meaning. Format: docs/MODULES.md.",
          "type": [
            "array",
            "null"
          ],
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "default",
              "meaning",
              "values",
              "range"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,32}$"
              },
              "type": {
                "enum": [
                  "bool",
                  "int",
                  "string"
                ]
              },
              "default": {
                "type": [
                  "boolean",
                  "integer",
                  "string"
                ]
              },
              "meaning": {
                "type": "string",
                "maxLength": 400
              },
              "values": {
                "type": [
                  "array",
                  "null"
                ],
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": [
                    "boolean",
                    "integer",
                    "string"
                  ]
                }
              },
              "range": {
                "type": [
                  "array",
                  "null"
                ],
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "compositionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "title",
        "game",
        "tags",
        "base",
        "map",
        "origin",
        "donor",
        "members"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "game": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "base": {
          "type": "string"
        },
        "map": {
          "type": "string"
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "donor": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "role",
              "name",
              "commit",
              "parameters"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "module",
                  "base"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "commit": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "parameters": {
                "description": "What this member sets on its module's declared parameters; empty when it sets none.",
                "type": "object",
                "maxProperties": 32,
                "additionalProperties": {
                  "type": [
                    "boolean",
                    "integer",
                    "string"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
